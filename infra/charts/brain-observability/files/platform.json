      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 16,
      "title": "Sanitized operational logs; expand trace_id/domain_trace_id for correlation",
      "type": "logs",
      "gridPos": {
        "x": 0,
        "y": 58,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "loki",
        "uid": "brain-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=~\".+\"}"
        }
      ],
      "options": {
        "showLabels": true,
        "showTime": true,
        "wrapLogMessage": false
      }
    },
    {
      "id": 17,
      "title": "JVM CPU utilization",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 44,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "brain-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "jvm_cpu_recent_utilization_ratio",
