{
  "connector.class": "io.debezium.connector.postgresql.PostgresConnector",
  "tasks.max": "1",
  "database.hostname": "brain-postgres.brain-data.svc",
  "database.port": "5432",
  "database.user": "brain_knowledge_cdc",
  "database.password": "${file:/secrets/knowledge.properties:password}",
  "database.dbname": "brain_knowledge",
  "plugin.name": "pgoutput",
  "topic.prefix": "knowledge-cdc",
  "slot.name": "knowledge_outbox_v1",
  "publication.name": "knowledge_outbox",
  "publication.autocreate.mode": "disabled",
  "table.include.list": "public.outbox_event",
  "snapshot.mode": "initial",
  "snapshot.include.collection.list": "public.outbox_event",
  "tombstones.on.delete": "false",
  "binary.handling.mode": "bytes",
  "include.schema.changes": "false",
  "provide.transaction.metadata": "false",
  "heartbeat.interval.ms": "0",
  "errors.tolerance": "none",
  "key.converter": "org.apache.kafka.connect.storage.StringConverter",
  "value.converter": "io.debezium.converters.BinaryDataConverter",
  "value.converter.delegate.converter.type": "org.apache.kafka.connect.json.JsonConverter",
  "value.converter.delegate.converter.type.schemas.enable": "false",
  "transforms": "outbox,eventVersion",
  "predicates": "onlyOutbox",
  "predicates.onlyOutbox.type": "org.apache.kafka.connect.transforms.predicates.TopicNameMatches",
  "predicates.onlyOutbox.pattern": "knowledge-cdc\\.public\\.outbox_event",
  "transforms.outbox.predicate": "onlyOutbox",
  "transforms.outbox.type": "io.debezium.transforms.outbox.EventRouter",
  "transforms.outbox.route.topic.replacement": "knowledge.${routedByValue}.v1",
  "transforms.outbox.table.fields.additional.placement": "trace_id:header:trace_id,schema_group:header:schema_group,schema_artifact:header:schema_artifact,schema_version:header:schema_version",
  "transforms.outbox.table.op.invalid.behavior": "fatal",
  "transforms.eventVersion.type": "org.apache.kafka.connect.transforms.RegexRouter",
  "transforms.eventVersion.regex": "^(knowledge\\.(?:claim|citation|qualifier))-v2\\.v1$",
  "transforms.eventVersion.replacement": "$1.v2"
}
